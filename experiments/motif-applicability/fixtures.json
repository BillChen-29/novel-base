  "projects": [
    {
      "schema_version": 1,
      "project_id": "atomic-password",
      "title": "内容知道了，载体仍未获知",
      "characters": [
        "阿岚",
        "阿弥",
        "阿驰"
      ],
      "pov_character": "阿弥",
      "goal": {
        "id": "recover_and_investigate",
        "description": "根据当前已经获知的内容选择下一步。"
      },
      "scenes": [
        {
          "id": "d1",
          "order": 1,
          "text": "这次值班交接约定的暗号是“松果”。阿岚在屋内读完信，信上写着这个暗号。阿弥等在门外，没有看见这封信。馆规允许所有值班人获取暗号，明确说明它只是普通交接信息，不是神圣知识，也不存在获取禁令。阿岚可以自由交流，没有受到威胁。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "阿岚"
          ]
        },
        {
          "id": "d2",
          "order": 2,
          "text": "阿岚出门告诉阿弥：“暗号是松果。”阿弥听清后复述：“松果，我记住了。”阿岚没有提信的存在。阿驰在远处戴着隔音耳机修车，没有听见这次对话。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "阿岚",
            "阿弥"
          ]
        }
      ],
