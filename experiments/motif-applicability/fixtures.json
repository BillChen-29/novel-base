    {
      "schema_version": 1,
      "project_id": "atomic-woven",
      "title": "收到绣布之后，怎样才算理解",
      "characters": [
        "青禾",
        "乔宁",
        "沈师傅"
      ],
      "pov_character": "乔宁",
      "goal": {
        "id": "recover_and_investigate",
        "description": "根据当前已经获知的内容选择下一步。"
      },
      "scenes": [
        {
          "id": "w1",
          "order": 1,
          "text": "乔宁亲眼看到看守威胁青禾：若向人说出她遭受的暴行，就伤害她的家人。青禾被迫沉默。青禾后来把这些罪行逐一编成绣图，缝在蓝绣布上。乔宁在旁看到她完成绣图；青禾指着自己和绣图，写下“我的遭遇”，乔宁明白蓝绣布记录了青禾受害的经历，但还不知道图案具体讲了什么。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "青禾",
            "乔宁"
          ]
        },
        {
          "id": "w2",
          "order": 2,
          "text": "青禾把蓝绣布交给乔宁，乔宁将它收好。乔宁知道蓝绣布仍需解读，自己此刻还看不懂其中的编码。乔宁知道沈师傅懂这种绣图编码；沈师傅刚发来消息，说自己在隔壁，可以随时联系。乔宁目前没有绣图对照表。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "青禾",
            "乔宁"
          ]
        },
        {
          "id": "w3",
          "order": 3,
          "text": "沈师傅到来后，把绣图对照表交给乔宁；这张表能够解读蓝绣布。乔宁把表握在手里，尚未开始逐项核对。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "乔宁",
            "沈师傅"
          ]
        },
        {
          "id": "w4",
          "order": 4,
          "text": "乔宁逐项用对照表核对蓝绣布，正确读出了青禾被拘禁和殴打的经过。他终于理解了布上记录的罪行。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "乔宁"
          ]
        }
      ],
      "facts": [
        {
          "id": "f01",
