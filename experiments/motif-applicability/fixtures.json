    {
      "schema_version": 1,
      "project_id": "atomic-forbidden",
      "title": "获取力量之后，代价还没有发生",
      "characters": [
        "岑火",
        "守庙人"
      ],
      "pov_character": "岑火",
      "goal": {
        "id": "recover_and_investigate",
        "description": "根据当前已经获知的内容选择下一步。"
      },
      "scenes": [
        {
          "id": "k1",
          "order": 1,
          "text": "山神留下不可更改的禁令：凡人岑火不得获取返生秘术，那是神圣知识。岑火与守庙人一同读到禁令。岑火当着守庙人的面决定，仍要设法取得返生秘术。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "岑火",
            "守庙人"
          ]
        },
        {
          "id": "k2",
          "order": 2,
          "text": "岑火穿过石门，读懂返生秘术，当即让一株枯死的小树重生。叙述者确认这是秘术赋予的超常力量。守庙人亲眼看见全程。此刻，山神尚未对岑火施加任何惩罚。",
          "function": "investigation",
          "tension": 2,
          "present_characters": [
            "岑火",
            "守庙人"
          ]
        }
      ],
      "facts": [
