        }
      ],
      "variants": [
        {
          "id": "suspense_inquiry_continue",
          "title": "先区分观察与推断，再核对疑点",
          "from_stage": "open_question",
          "requires": [],
          "proposal": "从已知观察或已提出的假说中选择可核对的一项，继续观察、提问或比对；核对结果可以支持、修正或否定原假说，不预先写出答案。"
