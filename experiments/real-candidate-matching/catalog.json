        "evidence": [
          {
            "start": 37,
            "end": 76,
            "quote": "主角隐藏真实身份生活，面具逐渐与真实自我融合，直到他分不清哪个才是真正的自己。"
          },
          {
            "start": 89,
            "end": 133,
            "quote": "1. **触发**：主角因某种原因（逃避追杀/执行任务/自我保护）必须以另一个身份生活。"
          }
        ]
      },
      "roles": {
