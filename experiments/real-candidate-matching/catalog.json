  "motifs": [
    {
      "id": "truth_pursuit",
      "title": "真相追寻：追查与阻力",
      "knowledge_kind": "motif",
      "source": {
        "path": "assets/motif_library/truth-pursuit.md",
        "sha256": "b0900e167687867d1408fc2e57d8ef2a0cc92c9d25209621084a198da1b2ad42",
        "evidence": [
          {
            "start": 37,
            "end": 77,
            "quote": "主角执着于追寻某个真相，但真相可能毁灭自己或身边的人——知道得越多，越无法回头。"
          },
          {
            "start": 90,
            "end": 128,
            "quote": "1. **触发**：主角发现一个疑点（失踪/死亡/异常事件），决定追查到底。"
          },
          {
            "start": 175,
            "end": 241,
            "quote": "3. **冲突**：每接近真相一步，就有人警告他停下——威胁、利诱、甚至来自信任之人的阻挠。主角在\"继续查\"和\"保全自己\"之间拉扯。"
          }
        ]
      },
      "roles": {
        "actor": "character",
        "question": "object"
      },
      "conditions": [
        {
          "id": "investigating",
          "kind": "world_state",
          "claim_template": "{actor}已经开始主动追查{question}。"
        },
        {
          "id": "obstructed",
          "kind": "world_state",
          "claim_template": "{actor}因追查{question}已经受到明确的阻挠或警告。"
        }
      ],
      "entry_conditions": [
        "investigating",
        "obstructed"
      ],
      "stages": [
        {
          "id": "applicable",
          "title": "当前操作条件得到支持",
          "requires": [
            "investigating",
            "obstructed"
          ],
          "chronological": []
        }
      ],
      "variants": [
        {
          "id": "truth_pursuit_continue",
          "title": "在既有阻力下选择如何追查",
          "from_stage": "applicable",
          "requires": [],
          "proposal": "根据已有调查线索与已发生的阻挠，选择继续核对、寻求支持或调整行动方式；不要补造更大的阴谋或调查结局。"
        }
      ],
      "operationalization_note": "只操作化“追查＋明确阻力”这一部分机制；一般调查可有局部支持，不等于本母题整体成立。未来代价未发生不构成反证。"
    },
    {
      "id": "identity_mask",
      "title": "身份面具：以另一身份生活",
      "knowledge_kind": "motif",
      "source": {
