    {
      "case_id": "repair_bench",
      "episode_id": "repair_bench",
      "source": {
        "schema_version": 1,
        "project_id": "repair_bench",
        "title": "长凳两端",
        "pov_character": "邵梨",
        "characters": [
          "邵梨"
        ],
        "goal": {
          "id": "recover_and_investigate",
          "description": "稳住待卸弦的古琴，并查明另一把琴背板细线的性质。"
        },
        "scenes": [
          {
            "id": "s1",
            "order": 1,
            "function": "forward_current",
            "tension": 2,
            "present_characters": [
              "邵梨"
            ],
            "text": "修琴铺开门，邵梨照例把两把待修的琴分放在长凳两端。左边的古琴要垫稳才好卸弦，右边的小提琴背板上有道细线。她刚从抽屉里找出一块厚毡和一盏弯颈灯。"
          },
          {
            "id": "s2",
            "order": 2,
            "function": "forward_current",
            "tension": 2,
            "present_characters": [
              "邵梨"
            ],
            "text": "古琴在凳面上轻轻一晃。邵梨拿起厚毡，准备把它垫到古琴底下稳住琴身；毡还攥在她手里，琴底空着。右边背板那条线，究竟是铅笔印还是沿纹裂开了？她扳亮弯颈灯，把放大镜摆在背板旁边，预备顺着那条线的边缘看，现在还没凑到镜前。"
          }
        ],
        "facts": [],
        "threads": []
      },
